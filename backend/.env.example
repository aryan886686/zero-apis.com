# Copy this to .env and fill in the values

NODE_ENV=production
PORT=10000

# MongoDB Atlas (REQUIRED)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/api_gateway?appName=...

# JWT Secret – generate a strong random string
JWT_SECRET=CHANGE_ME_USE_RANDOM_64_CHARS

JWT_EXPIRES_IN=24h

# Default super admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongPassword123
